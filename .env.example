# ---- HUSTL environment variables (placeholders only — copy to .env) ----

# Supabase (frontend-safe values only: project URL + publishable/anon key).
# NEVER put a service-role key or database password in this project.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Gemini AI — server-side only (read by server.ts, never sent to the browser).
# Get a key at https://aistudio.google.com/apikey . Leave blank to run without AI.
GEMINI_API_KEY=""
# Optional: override the default model (gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# Optional server settings
PORT=3000
# HOST=127.0.0.1   # use 0.0.0.0 only if you want other devices on your Wi-Fi to reach it
